# SAM3 Web Application Environment Configuration
# Copy this file to .env and fill in your values

# Required: Hugging Face token for model downloads
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Optional: kie.ai API key (for future features)
KIE_API_KEY=

# Optional: kie.ai API URL (defaults to placeholder)
KIE_API_URL=https://api.kie.ai/v1/generate/nano-banana

# Server configuration
HOST=0.0.0.0
PORT=8000

# Device configuration (cuda or cpu)
# Leave empty to auto-detect
CUDA_VISIBLE_DEVICES=0

# File paths
FRONTEND_DIR=../frontend/dist
TEMP_DIR=/tmp

# Processing settings
MAX_UPLOAD_SIZE=100  # in MB
SCORE_THRESHOLD=0.5  # detection score threshold (0.0 to 1.0)
